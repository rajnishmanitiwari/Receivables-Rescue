# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With none of it set, the app still:
#   - reads PDF invoices that have a text layer, deterministically
#   - reads CSV / TSV / pasted rows
#   - runs every calculation, including MSMED statutory interest
#   - writes every follow-up message from built-in templates
# ---------------------------------------------------------------------------

# MongoDB — an anonymous aggregate usage counter only. No invoice data is ever
# written. The app boots and works fine with this unset.
MONGO_URL=
DB_NAME=receivables_rescue

# AI layer. Setting these adds ONE capability: reading scanned PDFs and phone
# photos of paper invoices. Any OpenAI-compatible endpoint works.
# Example below is NVIDIA's hosted catalogue.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=moonshotai/kimi-k3
LLM_VISION_MODEL=moonshotai/kimi-k3

# Max size per uploaded file, in MB. Default 4, which stays inside Vercel's
# 4.5 MB serverless request-body cap. On a container host you can raise it.
MAX_UPLOAD_MB=4

CORS_ORIGINS=*
