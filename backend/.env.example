# MongoDB — used ONLY for an anonymous aggregate usage counter.
# The app runs fine with this unset.
MONGO_URL=
DB_NAME=receivables_rescue

# Optional. Without a key the app uses built-in message templates and works fully.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=*
